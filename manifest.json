{
  "manifest_version": 3,
  "name": "Lovable Control MVP",
  "version": "0.1.0",
  "description": "Describe cambios en lenguaje natural y aplícalos al repositorio GitHub sincronizado con Lovable.",
  "permissions": ["storage", "sidePanel", "activeTab"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "Lovable Control"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Abrir Lovable Control"
    }
  }
}